<Window x:Class="LinearArrayPlugin.ArraySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расстановка элементов"
        Height="320" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Длина между точками -->
        <TextBlock Grid.Row="0" 
                   x:Name="DistanceInfoTextBlock"
                   Text="Длина между точками: 0 мм"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Тип семейства -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Тип семейства:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="FamilyTypeComboBox"
                      DisplayMemberPath="DisplayName"
                      Height="28"/>
        </StackPanel>

        <!-- Количество элементов -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Количество элементов:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="CountTextBox"
                     Text="3"
                     Height="28"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3"
                   Text="Элементы будут равномерно распределены между указанными точками (первый — в начале, последний — в конце)."
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Разместить"
                    Width="120" Height="32" Margin="0,0,10,0"
                    IsDefault="True"
                    Click="PlaceButton_Click"/>
            <Button Content="Отмена"
                    Width="100" Height="32"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>